<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="single_wheel_test">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat terrain -->
    <model name="terrain_flat">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <box><size>20 4 0.1</size></box>
          </geometry>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <box><size>20 4 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.76 0.50 0.30 1</ambient>
            <diffuse>0.76 0.50 0.30 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Single wheel test rig -->
    <model name="test_rig">
      <pose>0 0 0.2 0 0 0</pose>

      <!-- Chassis -->
      <link name="Archimede_base_link_dummy">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.5</ixx><iyy>0.5</iyy><izz>0.5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <!-- Single wheel -->
      <link name="Archimede_fr_wheel_link">
        <pose relative_to="Archimede_base_link_dummy">0 0 0 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="wheel_collision">
          <geometry>
            <sphere><radius>0.085</radius></sphere>
          </geometry>
        </collision>
        <visual name="wheel_visual">
          <pose>0 0.016 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>../meshes/wheel_v2.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <sensor name="fr_contact_sensor" type="contact">
          <always_on>true</always_on>
          <update_rate>1000</update_rate>
          <contact>
            <collision>wheel_collision</collision>
          </contact>
        </sensor>
      </link>

      <!-- Wheel drive joint -->
      <joint name="Archimede_fr_drive_joint" type="revolute">
        <parent>Archimede_base_link_dummy</parent>
        <child>Archimede_fr_wheel_link</child>
        <axis><xyz>0 1 0</xyz></axis>
      </joint>

      <!-- Velocity controller -->
      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>Archimede_fr_drive_joint</joint_name>
        <use_force_commands>false</use_force_commands>
        <p_gain>1.0</p_gain>
        <i_gain>0.1</i_gain>
      </plugin>

    </model>
  </world>
</sdf>
